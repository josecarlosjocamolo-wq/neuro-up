# =====================================================================
#  Neuro Up — plantilla de variables de entorno
# =====================================================================
#  USO:
#    1. Copia este archivo a `.env` en la raíz del proyecto:
#         cp .env.example .env
#    2. Rellena tus valores en `.env`.
#    3. Compila con el script que inyecta los valores:
#         .\scripts\flutter-env.ps1 build apk -Mode release
#
#  REGLAS DE ORO:
#    * NUNCA subas `.env` a git (ya está en .gitignore).
#    * NUNCA pegues una clave directamente en un archivo .dart.
#    * La clave de IA no debe empaquetarse en el APK de distribución:
#      cualquier APK se puede descompilar y leer. Para eso el usuario
#      introduce su propia clave en la app (Ajustes del chat > Clave de IA),
#      que se guarda cifrada en SharedPreferences de SU dispositivo.
#      Solo úsate `AI_API_KEY` aquí para tus builds de desarrollo/demo.
# =====================================================================

# --- Chat con IA (API compatible con OpenAI) ------------------------
# Formato de la clave: sk-...  /  Vacío = el chat usa el motor local de reglas.
AI_API_KEY=
# Endpoint del proveedor (OpenAI, LM Studio, Ollama, Groq, etc.)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Reservado: Supabase (ya NO se usa) -----------------------------
# El backend fue migrado a SQLite local: no hay URL ni claves de Supabase.
# Deja esto vacío y, si algún día se reintegra el backend, configúralo
# por estas variables y NUNCA lo escribas en el código.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# La service_role key es de SOLO uso servidor y jamás debe viajar en una
# app cliente ni en este repositorio. Si la necesitas, está en un gestor
# de secretos, no aquí.
SUPABASE_SERVICE_ROLE_KEY=
